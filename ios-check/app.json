{
  "expo": {
    "name": "The Gap",
    "slug": "the-gap",
    "version": "1.3.0",
    "scheme": "thegap",
    "ios": {
      "bundleIdentifier": "com.causalme.thegap",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.causalme.thegap"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/withQuickLog",
      "./plugins/withHealthBackground",
      [
        "react-native-health",
        {
          "healthSharePermission": "Reads health data.",
          "healthUpdatePermission": "No writes."
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "A4JR7U9VZ3"
        }
      ]
    ]
  }
}
